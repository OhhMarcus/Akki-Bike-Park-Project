# Copy to .env.local. Everything is optional: with no variables the app runs as a
# fully local demo (mock data + localStorage).

# --- Supabase (optional: enables real persistence in the API routes) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (optional: Stripe or another HK-compatible provider) ---
# Server only. Card data must only ever touch the provider's hosted fields.
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "false" to hide the amber DEMO labels on placeholder content.
NEXT_PUBLIC_SHOW_DEMO_LABELS=true

# --- Demo admin login (replace with Supabase Auth in production) ---
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@akki-demo.hk
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=akki-demo-2025
